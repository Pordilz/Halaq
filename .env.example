# =====================================================================
# Halaq — environment variables
#
# Copy this file to `.env`. Vite picks it up for the browser build, and the
# local API server loads the same file (`node --env-file=.env server/index.js`),
# so keep both browser (VITE_*) and server-only variables here.
#
# Only VITE_-prefixed variables are embedded in the browser bundle. Everything
# else stays on the server — never put a secret behind a VITE_ prefix.
# =====================================================================

# ---- Public app ----
# Canonical web origin. Used for post-checkout redirects and as the fallback
# production CORS origin when APP_ORIGIN is unset.
VITE_APP_URL=http://localhost:3000

# Explicit browser-to-API CORS allowlist (api/_lib/cors.js). Comma-separated.
# The native shells (capacitor://localhost, https://localhost, http://localhost)
# are always allowed; this is for the real production web origin.
# On Vercel set this to your deployed origin. The per-request value set by
# api/_lib/cors.js overrides the static CORS default in vercel.json.
# If you change your production domain, update that static default too.
APP_ORIGIN=https://halaq.app

# Optional. Android/iOS builds call a deployed API cross-origin; leave empty
# for the web build so calls stay relative to /api. See .env.android.example.
VITE_API_BASE_URL=

# ---- Supabase ----
# https://supabase.com/dashboard -> Project Settings -> API
# Used by the browser client and as the server-side fallback for SUPABASE_URL.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only — never expose these to the browser.
# Used by API routes for auth verification, profile updates, webhooks, and the
# atomic quota RPCs (migration 008). The service role key is REQUIRED: without
# it the billing-field lock (migration 006) blocks every billing write.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: salt for the hashed client IPs behind the signed-out screening
# limit (migration 008). Defaults to the service role key; set a separate
# random value if you want to rotate it independently.
ANON_QUOTA_SALT=

# ---- Lemon Squeezy billing ----
# https://app.lemonsqueezy.com/settings/api
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_PRO_VARIANT_ID=
LEMON_SCHOLAR_VARIANT_ID=

# ---- Optional: diagnostics / local dev server ----
# Set to 1 to log webhook events (off by default).
WEBHOOK_DEBUG=
# Local API server port and mode (defaults: 3005 / unset).
PORT=
NODE_ENV=
# Build target override: "android" or "ios" selects HashRouter in native shells.
# Normally inferred from the npm script's Vite mode; set only when needed.
VITE_PLATFORM=
