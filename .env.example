# =====================================================================
# Halaq — environment variables
# Copy this file to `.env.local` (Vite picks it up automatically).
# Variables prefixed with VITE_ are exposed to the browser bundle.
# =====================================================================

# ---- Public app ----
VITE_APP_URL=http://localhost:3000

# ---- Supabase ----
# https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only — never expose this to the browser.
# Used by API routes for auth verification, profile updates, webhooks.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---- Lemon Squeezy billing ----
# https://app.lemonsqueezy.com/settings/api
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_PRO_VARIANT_ID=
LEMON_SCHOLAR_VARIANT_ID=

# ---- Optional: Yahoo Finance proxying (none needed; library is keyless) ----
