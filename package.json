{
  "name": "halaq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:api\"",
    "dev:ui": "vite",
    "dev:api": "node --env-file=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.js\"",
    "android:build": "vite build --mode android && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:build && cap run android",
    "android:assets": "npx --yes @capacitor/assets@3 generate --android",
    "android:apk": "npm run android:build && cd android && ./gradlew assembleRelease",
    "android:aab": "npm run android:build && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@lemonsqueezy/lemonsqueezy.js": "^4.0.0",
    "@supabase/supabase-js": "^2.100.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4",
    "yahoo-finance2": "^3.13.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5"
  }
}
