<?xml version="1.0" encoding="utf-8"?>
<!--
  Block both cloud and device-to-device transfer of app data.
  Halaq caches Supabase session tokens and watchlist data; we don't
  want either to be copied to Google Drive or to a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
