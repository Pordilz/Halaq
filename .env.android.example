# Used when building the Android (Capacitor) bundle.
# Vite picks this up via `vite build --mode android`.
# The web build (Vercel) leaves this unset so calls stay relative to /api.

VITE_API_BASE_URL=https://your-app.vercel.app

# Supabase (same as .env — duplicated so the Android bundle has them at build time).
# Copy this file to .env.android and fill in your project's values.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key
